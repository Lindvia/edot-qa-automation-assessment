# Copy this file to .env and fill in real values.
# .env is gitignored - never commit credentials or API keys.

# --- Web (eSuite) ---
ESUITE_URL=https://esuite.edot.id
ESUITE_EMAIL=
ESUITE_PASSWORD=
HEADLESS=true
# Seconds a deleted company may remain in the list before the delete test fails (deletion is asynchronous)
DELETE_WAIT_SECONDS=180

# --- Mobile (eWork SFA) ---
MOBILE_APP_ID=
MOBILE_COMPANY_ID=
MOBILE_USERNAME=
MOBILE_PASSWORD=
# "maestro" on macOS/Linux; on Windows run Maestro inside WSL: "wsl maestro"
MAESTRO_CMD=maestro
# true = record the screen with adb screenrecord and attach the video to Allure
MOBILE_RECORD=false
MOBILE_FLOW_TIMEOUT=900

# --- AI (optional; with nothing set the suite falls back to Faker and triage runs rules-only) ---
# Free option: any OpenAI-compatible endpoint. Set AI_BASE_URL + AI_MODEL (+ AI_API_KEY if it wants one).
# Examples (check the provider for its current free model names):
#   Groq    AI_BASE_URL=https://api.groq.com/openai/v1                  AI_MODEL=llama-3.1-8b-instant
#   Gemini  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai   AI_MODEL=gemini-2.0-flash
#   Ollama  AI_BASE_URL=http://localhost:11434/v1  (no key, runs on your machine)  AI_MODEL=llama3.2
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Alternative: Anthropic (used only when AI_BASE_URL is empty; AI_MODEL defaults to a small Claude model)
ANTHROPIC_API_KEY=
FAKER_SEED=20261002
